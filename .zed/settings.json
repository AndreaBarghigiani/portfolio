{
  "languages": {
    "Astro": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath={buffer_path}"]
        }
      },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports": false,
        "source.fixAll": false,
        "source.fixAll.eslint": false,
        "source.fixAll.oxc": false
      }
    },
