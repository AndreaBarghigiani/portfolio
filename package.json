{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "astro dev",
    "dev:serve": "tailscale serve --yes --bg --https=8448 http://127.0.0.1:4322",
    "dev:tailscale": "pnpm dev:serve && ASTRO_TAILSCALE=1 astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/vercel": "^9.0.4",
    "@fontsource-variable/figtree": "^5.2.10",
    "@lucide/astro": "^0.542.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.17.1",
    "astro-icon": "^1.1.5",
    "marked": "^17.0.1",
    "motion": "^12.23.26",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@astrojs/compiler-rs": "0.5.2",
    "oxfmt": "0.74.0"
  }
}
