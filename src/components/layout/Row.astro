---
/**
 * One ruled row of a `Sheet`: a margin cell and a content cell
 * (docs/design-system.md section 5).
 *
 * - Titled: pass `title`. It renders as a real heading (`titleAs`, default h2)
 *   in the margin cell, and the row becomes a labelled `<section>`.
 * - Untitled: omit `title`. The margin cell stays empty on desktop and is
 *   dropped below `lg`. Use the named `margin` slot for a small label or
 *   other margin content instead of a title.
 * - Omitted margin: set `noMargin` for a row with one solid content ground
 *   across the full viewport and no margin cell.
 * - `tone` picks the band: `surface` (default), `raised`, `paper` (kraft) or
 *   `accent`. Each tone also picks the matching margin, rule and ink roles.
 * - `framed` draws the 1px list right rule just outside the 1440px cells above
 *   1442px (#82). Set it on each row of a list that should show the rule, such
 *   as home projects and experience, course modules, and series entries. The
 *   rule is a segment beside that row; it joins the next framed row's rule
 *   across the hairline. Archive pages use `framed` on the page instead.
 *
 * The row is full viewport width. Its grounds come from `band-grounds`
 * (docs/design-system.md section 5): the margin ground to the left of the
 * sheet's margin edge, the content ground to the right, across the gutters.
 * The cells sit in a page-width container, so the 1440px cap is per row.
 *
 * DOM order is margin cell first, content second; it is never reordered with
 * CSS, so landmark and heading order do not depend on visual placement.
 * Content fills the cell; set `measure="copy"` to cap it at the 720px reading
 * width. Set `flush` to remove the content cell's horizontal and vertical
 * padding when children provide their own insets and spacing. `class` is applied to the wrapper
 * inside the content cell.
 */
type Tone = 'surface' | 'raised' | 'paper' | 'accent';
type TitleLevel = 'h1' | 'h2' | 'h3';

import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'div'>, 'title' | 'class'> {
  title?: string;
  titleAs?: TitleLevel;
  tone?: Tone;
  noMargin?: boolean;
  /** Remove content-cell padding when children provide their own insets and spacing. */
  flush?: boolean;
  /** Place the margin cell after the content in the DOM (visually first on desktop), e.g. a hero figure that should follow the text on mobile. */
  marginAfter?: boolean;
  /** Slogan-sized margin title (56px black) instead of the default section title. */
  display?: boolean;
  /** Mono label above the margin title, such as a module number and lesson count. */
  eyebrow?: string;
  /** Archive year heading (72px black, section 4) instead of the default section title. */
  year?: boolean;
  /** Draw the list right rule beside this row above 1442px (#82). */
  framed?: boolean;
  measure?: 'full' | 'copy';
  id?: string;
  class?: string;
}

const {
  title,
  titleAs = 'h2',
  tone = 'surface',
  noMargin = false,
  flush = false,
  marginAfter = false,
  display = false,
  year = false,
  framed = false,
  eyebrow,
  measure = 'full',
  id,
  class: className,
  ...rest
} = Astro.props;

const marginHtml = Astro.slots.has('margin') ? (await Astro.slots.render('margin')).trim() : '';
const hasMarginSlot = marginHtml !== '';
const hasMargin = !noMargin && (Boolean(title) || hasMarginSlot);
const slug = title
  ?.toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const headingId = title ? `${id ?? slug}-title` : undefined;

/*
 * `band` sets the two grounds the band-grounds utility paints: the margin
 * ground for the gutter and margin cell, and the content ground for the
 * gutter and content cell. The content cell itself stays transparent.
 */
const tones: Record<
  Tone,
  { row: string; band: string; margin: string; content: string; title: string }
> = {
  surface: {
    row: 'border-rule',
    band: '[--band-margin:var(--ds-margin)] [--band-content:var(--ds-surface)]',
    margin: 'bg-margin text-ink-subtle lg:[box-shadow:inset_-1px_0_0_var(--ds-rule)]',
    content: '',
    title: 'text-ink',
  },
  raised: {
    row: 'border-rule',
    band: '[--band-margin:var(--ds-margin)] [--band-content:var(--ds-raised)]',
    margin: 'bg-margin text-ink-subtle lg:[box-shadow:inset_-1px_0_0_var(--ds-rule)]',
    content: '',
    title: 'text-ink',
  },
  paper: {
    row: 'border-paper-rule',
    band: '[--band-margin:var(--ds-paper-margin)] [--band-content:var(--ds-paper)]',
    margin: 'bg-paper-margin text-paper-ink-subtle lg:border-r lg:border-paper-rule',
    content: 'text-paper-ink',
    title: 'text-paper-ink',
  },
  accent: {
    row: 'border-accent-deep',
    band: '[--band-margin:var(--ds-accent-deep)] [--band-content:var(--ds-accent)]',
    margin: 'bg-accent-deep text-on-accent lg:border-r lg:border-accent-deep',
    content: 'text-on-accent',
    title: 'text-on-accent',
  },
};

const t = tones[tone];
const titleClass = [
  t.title,
  'text-2xl font-black tracking-tight',
  display && 'lg:text-4xl',
  year && 'lg:text-(length:--year-title-size) lg:leading-[72px] lg:tracking-display',
  !display && !year && 'lg:text-3xl',
]
  .filter(Boolean)
  .join(' ');
const Wrapper = title ? 'section' : 'div';
import RowMargin from './RowMargin.astro';
---

<Wrapper
  {...rest}
  {id}
  aria-labelledby={headingId}
  class:list={['border-b', noMargin ? 'band-solid' : 'band-grounds', t.band, t.row]}
>
  <div
    class:list={[
      'mx-auto w-full max-w-page',
      framed && 'row-rule',
      marginAfter ? 'flex flex-col lg:flex-row' : 'lg:flex',
    ]}
  >
    {!noMargin && !marginAfter && (
      <RowMargin
        as={titleAs}
        {title}
        {eyebrow}
        {headingId}
        html={marginHtml}
        visible={hasMargin}
        after={false}
        marginClass={t.margin}
        {titleClass}
      />
    )}
    <div class:list={['min-w-0 flex-1', !flush && 'px-6 py-8 lg:px-12 lg:py-12', t.content]}>
      <div class:list={[measure === 'copy' && 'max-w-copy', className]}>
        <slot />
      </div>
    </div>
    {!noMargin && marginAfter && (
      <RowMargin
        as={titleAs}
        {title}
        {eyebrow}
        {headingId}
        html={marginHtml}
        visible={hasMargin}
        after={true}
        marginClass={t.margin}
        {titleClass}
      />
    )}
  </div>
</Wrapper>
