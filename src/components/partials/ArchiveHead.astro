---
/**
 * Archive head (docs/design-system.md section 9): the Posts / Series / Notes
 * sub-nav with counts in the margin cell, page title and standfirst in the
 * content cell. Pass `current` for the active sub-nav item; omit it for
 * archives outside the writing group (changelog), which render no sub-nav.
 * Whether this sub-nav stays alongside the header submenu is an open owner
 * decision (#43).
 */
import Row from '@/components/layout/Row.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  current?: 'posts' | 'series' | 'notes';
}

const { title, current } = Astro.props;

const [posts, series, notes] = current
  ? await Promise.all([getCollection('posts'), getCollection('series'), getCollection('notes')])
  : [[], [], []];
const items = [
  { key: 'posts', label: 'Posts', href: '/posts/', count: posts.length },
  { key: 'series', label: 'Series', href: '/series/', count: series.length },
  { key: 'notes', label: 'Notes', href: '/notes/', count: notes.length },
] as const;
---

<Row>
  {current && <nav
    slot="margin"
    aria-label="Archives"
    class="-mx-6 -my-4 font-sans tracking-[normal] normal-case lg:mx-0 lg:mt-auto lg:mb-0"
  >
    <p
      class="mb-4 hidden font-mono text-label tracking-label text-ink-subtle uppercase lg:block"
      aria-hidden="true"
    >
      Writing
    </p>
    <ul class="flex lg:flex-col lg:gap-3">
      {items.map((item) => <li
        class="min-w-0 flex-1 border-r border-rule last:border-r-0 lg:flex-none lg:border-r-0"
      >
        <a
          href={item.href}
          aria-current={item.key === current ? 'page' : undefined}
          class:list={[
            'flex min-h-12 items-center justify-center gap-2 text-sm hover:text-accent-hover lg:min-h-0 lg:justify-between lg:text-base lg:leading-[22px]',
            item.key === current ? 'font-bold text-accent' : 'text-ink',
          ]}
        >
          {item.label}
          <span
            class:list={[
              'font-mono text-label font-normal',
              item.key === current ? 'text-accent' : 'text-ink-subtle',
            ]}
          >
            {item.count}
          </span>
        </a>
      </li>)}
    </ul>
  </nav>}
  <h1 class="text-3xl font-black tracking-display [overflow-wrap:anywhere] text-ink lg:text-6xl">
    {title}
  </h1>
  <div
    class="mt-6 text-lg leading-8 font-light text-accent lg:mt-8 lg:text-xl lg:leading-10 lg:tracking-[-0.01em]"
  >
    <slot />
  </div>
</Row>
