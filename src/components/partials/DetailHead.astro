---
/**
 * Head of a detail page (docs/design-system.md section 9): the "← Back to
 * {archive}" link and facts in the margin cell, the title and standfirst in
 * the content cell. Put facts in the `facts` slot; put other margin content
 * in the default-less `margin` slot. The back link appears here once and once
 * in the footer, never in the reading bar.
 */
import Row from '@/components/layout/Row.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';

interface Props {
  title: string;
  standfirst?: string;
  back: { label: string; href: string };
}

const { title, standfirst, back } = Astro.props;
---

<Row>
  <div slot="margin" class="flex flex-col gap-6 normal-case lg:flex-1 [&>dl]:mt-auto">
    <ArrowLink href={back.href} direction="back" class="font-sans text-sm tracking-[normal]">
      Back to {back.label}
    </ArrowLink>
    <slot name="facts" />
  </div>
  <h1 class="text-3xl font-black tracking-display [overflow-wrap:anywhere] text-ink lg:text-6xl">
    {title}
  </h1>
  {standfirst && <p
    class="mt-6 text-lg leading-8 font-light text-accent lg:mt-8 lg:text-xl lg:leading-10 lg:tracking-[-0.01em]"
  >
    {standfirst}
  </p>}
  <slot name="actions" />
</Row>
