---
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import { getSheetMeta } from '@/lib/sheet';

const { back } = getSheetMeta(Astro.url.pathname);
const wordmark = DEFAULT_CONFIGURATION.author.username ?? 'cupofcraft';
const links = [
  { href: '/posts', label: 'Writing' },
  { href: '/notes', label: 'Notes' },
  { href: '/changelog', label: 'Changelog' },
];
---

<footer class="border-t border-rule bg-surface text-ink">
  <div class="mx-auto flex w-full max-w-page flex-col lg:flex-row">
    <div class="bg-margin px-6 py-6 lg:w-label lg:shrink-0 lg:border-r lg:border-rule lg:p-12">
      <p class="text-lg font-semibold tracking-tight">{wordmark}</p>
      <p class="mt-1 font-mono text-label tracking-label text-ink-subtle">
        &copy; {new Date().getFullYear()}
      </p>
    </div>

    <nav aria-label="Footer" class="px-6 py-4 lg:flex lg:items-center lg:px-12 lg:py-12">
      <ul class="flex flex-col lg:flex-row lg:gap-8">
        {links.map((link) => <li>
          <a
            href={link.href}
            class="flex min-h-12 items-center text-sm text-ink-muted hover:text-accent-hover"
          >
            {link.label}
          </a>
        </li>)}
      </ul>
    </nav>

    <div class="px-6 pb-6 lg:ml-auto lg:flex lg:items-center lg:px-12 lg:py-12">
      {back ? (
        <a
          href={back.href}
          class="flex min-h-12 items-center text-sm text-ink hover:text-accent-hover"
        >
          <span aria-hidden="true">←&nbsp;</span>Back to {back.label}
        </a>
      ) : (
        <a
          href="#top"
          class="flex min-h-12 items-center font-hand text-xl text-accent hover:text-accent-hover"
        >
          back to top <span aria-hidden="true">&nbsp;↑</span>
        </a>
      )}
    </div>
  </div>
</footer>
