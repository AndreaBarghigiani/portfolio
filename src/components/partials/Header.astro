---
import NavLink from '@/components/ui/NavLink.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import { getSheetMeta } from '@/lib/sheet';
import { isCurrent } from '@/lib/utils';
import { ChevronDown } from '@lucide/astro';

const { pathname } = Astro.url;
const { code } = getSheetMeta(pathname);
const writing = [
  { href: '/posts', label: 'Posts' },
  { href: '/series', label: 'Series' },
  { href: '/notes', label: 'Notes' },
];
const inWriting = writing.some(
  (item) => isCurrent(pathname, item.href) || pathname.startsWith(`${item.href}/`)
);
const wordmark = DEFAULT_CONFIGURATION.author.username ?? 'cupofcraft';
const drawnBy = DEFAULT_CONFIGURATION.author.name;
---

<header
  data-header
  class="sticky top-[-56px] z-50 border-b border-rule bg-surface text-ink transition-transform duration-[180ms] ease-out motion-reduce:transition-none lg:top-0"
>
  <div class="mx-auto flex w-full max-w-page flex-col lg:min-h-20 lg:flex-row">
    <div
      class="flex h-14 items-stretch max-lg:border-b max-lg:border-rule lg:h-auto lg:w-label lg:shrink-0 lg:border-r lg:border-rule lg:bg-margin"
    >
      <a
        href="/"
        class="flex flex-1 items-center px-6 text-lg font-semibold tracking-tight text-ink lg:px-12"
      >
        {wordmark}
      </a>
      <div
        class="flex flex-col justify-center border-l border-rule px-6 font-mono text-label tracking-label text-ink-subtle uppercase lg:hidden"
      >
        <span>Sheet</span>
        <span class="text-ink">{code}</span>
      </div>
    </div>

    <div
      class="hidden flex-col justify-center border-r border-rule px-8 font-mono text-label tracking-label text-ink-subtle uppercase lg:flex"
    >
      <span>Sheet</span>
      <span class="text-xs text-ink">{code}</span>
    </div>

    <div
      class="hidden flex-col justify-center border-r border-rule px-8 font-mono text-label tracking-label text-ink-subtle uppercase lg:flex"
    >
      <span>Drawn by</span>
      <span class="text-xs text-ink">{drawnBy}</span>
    </div>

    <nav aria-label="Main" class="relative flex-1">
      <ul class="flex h-12 lg:h-full lg:justify-end">
        <NavLink href="/">Home</NavLink>

        <li class="relative flex min-w-0" data-submenu>
          <button
            type="button"
            data-submenu-trigger
            aria-expanded="false"
            aria-controls="writing-menu"
            class:list={[
              'flex min-h-12 min-w-0 flex-1 items-center justify-center gap-2 px-6 text-sm transition-colors hover:text-accent-hover max-lg:border-l max-lg:border-rule max-[359px]:px-2',
              inWriting ? 'font-bold text-accent' : 'text-ink-muted',
            ]}
          >
            Writing
            <ChevronDown class="size-4" aria-hidden="true" />
          </button>
          <ul
            id="writing-menu"
            data-submenu-panel
            class="absolute inset-x-0 top-full z-50 border border-x-0 border-rule bg-surface lg:right-auto lg:left-0 lg:min-w-[max(10rem,100%)] lg:border-x"
          >
            {writing.map((item) => {
              const current =
                isCurrent(pathname, item.href) || pathname.startsWith(`${item.href}/`);
              return <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(pathname, item.href) ? 'page' : undefined}
                  class:list={[
                    'flex min-h-12 items-center border-b border-rule px-6 text-sm last:border-b-0 hover:bg-raised hover:text-accent-hover',
                    current ? 'font-bold text-accent' : 'text-ink-muted',
                  ]}
                >
                  {item.label}
                </a>
              </li>;
            })}
          </ul>
        </li>

        <NavLink href="/changelog">Changelog</NavLink>
      </ul>
    </nav>
  </div>
</header>

<style is:global>
  :root {
    scroll-padding-top: 3rem;
  }
  @media (min-width: 1024px) {
    :root {
      scroll-padding-top: 5rem;
    }
  }
  [data-header][data-state='hidden'] {
    transform: translateY(-100%);
  }
  [data-header][data-state='revealed'] {
    box-shadow: 0 2px 0 var(--color-accent);
  }
  [data-submenu]:hover [data-submenu-panel],
  [data-submenu]:focus-within [data-submenu-panel] {
    display: block;
  }
  .js [data-submenu]:not(:has([data-submenu-trigger][aria-expanded='true'])) [data-submenu-panel] {
    display: none;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const submenu = header?.querySelector<HTMLElement>('[data-submenu]');
  const trigger = submenu?.querySelector<HTMLButtonElement>('[data-submenu-trigger]');
  const panel = submenu?.querySelector<HTMLElement>('[data-submenu-panel]');
  const hoverable = window.matchMedia('(hover: hover) and (min-width: 1024px)');

  const setOpen = (open: boolean) => {
    if (!trigger || !panel) return;
    trigger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  };
  const isOpen = () => trigger?.getAttribute('aria-expanded') === 'true';

  trigger?.addEventListener('click', (event) => {
    if (hoverable.matches && event.detail > 0) {
      setOpen(true);
      return;
    }
    setOpen(!isOpen());
  });
  submenu?.addEventListener('mouseenter', () => hoverable.matches && setOpen(true));
  submenu?.addEventListener('mouseleave', () => hoverable.matches && setOpen(false));
  submenu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      setOpen(false);
      trigger?.focus();
    }
  });
  submenu?.addEventListener('focusout', (event) => {
    if (!submenu.contains(event.relatedTarget as Node | null)) setOpen(false);
  });
  document.addEventListener('click', (event) => {
    if (isOpen() && !submenu?.contains(event.target as Node)) setOpen(false);
  });

  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const threshold = 6;

    const update = () => {
      ticking = false;
      const y = Math.max(window.scrollY, 0);
      const delta = y - lastY;
      const keepVisible = header.contains(document.activeElement) || isOpen();

      if (y <= 0) {
        header.dataset.state = 'top';
      } else if (Math.abs(delta) > threshold) {
        header.dataset.state = delta > 0 && !keepVisible ? 'hidden' : 'revealed';
      }
      lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    header.addEventListener('focusin', () => {
      if (header.dataset.state === 'hidden') header.dataset.state = 'revealed';
    });
  }
</script>
