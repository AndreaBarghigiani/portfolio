---
/**
 * A short human aside in Caveat: 28px, accent, tilted -2 degrees
 * (docs/design-system.md section 8). One per page, a few words, in a margin or
 * beside a figure, never over content. The tilt is static, so it is safe under
 * reduced motion. For the permanent untilted "back to top" use `BackToTop`.
 */
interface Props {
  as?: 'p' | 'span';
  class?: string;
}

const { as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['inline-block -rotate-2 font-hand text-xl text-accent', className]}>
  <slot />
</Tag>
