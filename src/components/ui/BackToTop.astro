---
/**
 * The permanent "back to top" control (footer and reading bar). Handwritten
 * but untilted, and its text stays real text for assistive technology; the
 * arrow is decorative. Targets `#top` on <body> (see BaseLayout).
 */
import { ARROWS } from '@/lib/links';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="#top"
  class:list={[
    'inline-flex min-h-12 items-center gap-1 font-hand text-xl text-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
    className,
  ]}
>
  back to top <span aria-hidden="true">{ARROWS.up}</span>
</a>
