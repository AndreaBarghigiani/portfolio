---
/**
 * Code block for authored content (docs/design-system.md section 8): margin
 * ground, hairline border, mono header with the language, mono body. Pass it
 * to MDX as the `pre` component (`<Content components={{ pre: CodeBlock }} />`)
 * so every fenced block uses it. When the code is wider than its box, a
 * "scrolls →" cue appears in the header, and the block is keyboard-scrollable
 * (focusable, labelled region).
 */
interface Props {
  'data-language'?: string;
  class?: string;
  [key: string]: unknown;
}

const language = Astro.props['data-language'];
const className = Astro.props.class;
const attrs = Object.fromEntries(
  Object.entries(Astro.props).filter(
    ([key]) => !['data-language', 'class', 'style', 'tabindex', 'role', 'aria-label'].includes(key)
  )
);
const label = language && language !== 'plaintext' ? language : 'code';
---

<div data-codeblock class="not-prose my-8 border border-rule bg-margin">
  <div
    class="flex items-center justify-between border-b border-rule px-4 py-2 font-mono text-label tracking-label text-ink-subtle uppercase"
  >
    <span>{label}</span>
    <span data-scroll-cue aria-hidden="true" class="hidden">scrolls →</span>
  </div>
  <pre
    {...attrs}
    class:list={[className, 'm-0 overflow-x-auto p-4 font-mono text-xs leading-6']}
    style="background: transparent !important"
    tabindex="0"
    role="region"
    aria-label={`${label} code, scrollable`}
  ><slot /></pre>
</div>

<script>
  const update = () =>
    document.querySelectorAll<HTMLElement>('[data-codeblock]').forEach((block) => {
      const pre = block.querySelector('pre');
      const cue = block.querySelector<HTMLElement>('[data-scroll-cue]');
      if (!pre || !cue) return;
      cue.classList.toggle('hidden', pre.scrollWidth <= pre.clientWidth);
    });
  update();
  window.addEventListener('resize', update);
</script>
