---
import type { CollectionEntry } from 'astro:content';

interface Props {
  course: CollectionEntry<'notes'>;
}

const { course } = Astro.props;
---

<li class="h-full rounded-lg p-2 transition-colors hover:bg-foreground/5">
  <a href={`/notes/${course.id}/`} class="flex flex-col gap-3">
    <h3 class="text-3xl font-medium text-headings">
      {course.data.title}
    </h3>

    <p>{course.data.description}</p>
  </a>
</li>
