---
/**
 * One archive row (docs/design-system.md section 8): mono date or index, title,
 * optional description, and a trailing arrow in a fixed 48px slot so the arrow
 * never shifts the text. The whole row is the link and the tap target.
 *
 * - States change colour and ground only, never dimensions. Hover raises the
 *   ground and accents the title and meta; keyboard focus adds the same plus a
 *   separate inset outline. Nothing depends on hover.
 * - `external` rows use `↗`, open in a new tab with `rel`, and announce it.
 * - `status` adds at most one status tag; `detail` is a small mono suffix
 *   (for example a PR number).
 * - `topics` adds plain topic chips below the description.
 * - `more` and `group` mark rows that the show-more control reveals.
 * - `variant`: `log` is the changelog's smaller title with a separate accent
 *   column for `detail` (section 4).
 * - The row link owns the cell's horizontal inset so its ground and hairline
 *   span the content cell; place it in a `flush` Row.
 */
import Tag, { type StatusTag } from './Tag.astro';
import TopicTags from './TopicTags.astro';
import { ARROWS } from '@/lib/links';

interface Props {
  href: string;
  title: string;
  meta: string;
  description?: string;
  detail?: string;
  status?: StatusTag;
  topics?: readonly string[];
  external?: boolean;
  more?: boolean;
  group?: string;
  variant?: 'default' | 'log';
}

const {
  href,
  title,
  meta,
  description,
  detail,
  status,
  topics = [],
  external = false,
  more,
  group,
  variant = 'default',
} = Astro.props;
---

<li
  data-entry
  data-more={more ? '' : undefined}
  data-more-group={more ? group : undefined}
  class="border-t border-rule first:border-t-0"
>
  <a
    {href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    class:list={[
      variant === 'log'
        ? 'lg:grid-cols-[72px_48px_minmax(0,1fr)_3rem] lg:gap-x-7'
        : 'lg:grid-cols-[8rem_minmax(0,1fr)_3rem]',
      'group grid min-h-12 grid-cols-[minmax(0,1fr)_3rem] items-baseline gap-x-4 px-6 py-6 outline-offset-[-2px] outline-accent hover:bg-raised focus-visible:bg-raised focus-visible:outline-2 lg:gap-x-6 lg:px-12',
    ]}
  >
    <span class="flex gap-3 lg:contents">
      <span
        class="font-mono text-xs text-ink-subtle group-hover:text-accent group-focus-visible:text-accent"
      >
        {meta}
      </span>
      {detail && <span class="font-mono text-xs font-medium text-accent">{detail}</span>}
    </span>
    <div
      class:list={[
        'col-start-1 flex flex-col gap-2',
        variant === 'log' ? 'lg:col-start-3' : 'lg:col-start-2',
      ]}
    >
      <span class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span
          class:list={[
            'min-w-0 break-words text-ink group-hover:text-accent group-focus-visible:text-accent',
            variant === 'log' &&
              'text-lg font-extrabold tracking-[-0.02em] lg:text-[26px] lg:leading-8 lg:tracking-[-0.025em]',
            variant === 'default' &&
              'text-xl font-extrabold tracking-[-0.025em] lg:text-2xl lg:tracking-[-0.03em]',
          ]}
        >
          {title}
        </span>
        {status && <Tag kind="status" {status} />}
      </span>
      {description && <span class="text-base text-ink-muted">{description}</span>}
      <TopicTags {topics} inLink class="mt-1" />
    </div>
    <span
      aria-hidden="true"
      class:list={[
        'col-start-2 row-span-2 row-start-1 self-center text-center text-lg text-accent lg:row-span-1',
        variant === 'log' ? 'lg:col-start-4' : 'lg:col-start-3',
      ]}
    >
      {external ? ARROWS.external : ARROWS.internal}
    </span>
    {external && <span class="sr-only"> (opens in a new tab)</span>}
  </a>
</li>
