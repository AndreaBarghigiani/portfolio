---
/**
 * Inline external link for MDX content (imported as `EL` in existing posts
 * and notes). A thin wrapper over `ArrowLink` that keeps the `isGFE` contract
 * so content files need no changes. Prefer `ArrowLink` in Astro code.
 */
import ArrowLink from './ArrowLink.astro';

type Props =
  | {
      href: string;
      isGFE?: false;
    }
  | {
      href?: string;
      isGFE: true;
    };

const { href = '', isGFE } = Astro.props;

const path = isGFE ? `https://www.greatfrontend.com${href}?fpr=cupofcraft` : href;
---

<ArrowLink href={path} inline><slot /></ArrowLink>
