---
/**
 * Closing kraft band ("Keep reading", "Next up", "More projects") from real
 * neighbouring content. Uses the paper tone and paper inks, never the dark
 * theme inks. Renders nothing when there are no items.
 */
import Row from '@/components/layout/Row.astro';
import { ARROWS } from '@/lib/links';

interface Item {
  href: string;
  title: string;
  meta?: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Keep reading', items } = Astro.props;
---

{items.length > 0 && <Row tone="paper" {title} id="keep-reading" flush>
  <ul class="flex flex-col lg:grid lg:auto-cols-fr lg:grid-flow-col">
    {items.map((item) => <li
      class="border-b border-paper-rule last:border-b-0 lg:border-r lg:border-b-0 lg:last:border-r-0"
    >
      <a
        href={item.href}
        class="group flex min-h-12 flex-col gap-3 px-6 py-8 outline-offset-[-2px] focus-visible:outline-2 focus-visible:outline-paper-ink lg:h-full lg:px-9 lg:pt-10 lg:pb-11"
      >
        {item.meta && <span
          class="font-mono text-label tracking-label text-paper-ink-subtle uppercase"
        >
          {item.meta}
        </span>}
        <span
          class="text-xl leading-8 font-extrabold tracking-[-0.025em] text-paper-ink group-hover:underline"
        >
          {item.title}
        </span>
        <span aria-hidden="true" class="text-sm font-bold text-paper-ink">
          {ARROWS.internal}
        </span>
      </a>
    </li>)}
  </ul>
</Row>}
