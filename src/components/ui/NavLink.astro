---
import { isCurrent } from '@/lib/utils';

interface Props {
  href: string;
}

const { href } = Astro.props;
const { pathname } = Astro.url;

const current = isCurrent(pathname, href);
---

<li class="flex">
  <a
    {href}
    aria-current={current ? 'page' : undefined}
    class:list={[
      'flex min-h-12 flex-1 items-center justify-center px-6 text-sm text-ink-muted transition-colors hover:text-accent-hover',
      'max-lg:border-l max-lg:border-rule max-lg:first:border-l-0',
      current && 'font-bold text-accent',
    ]}
  >
    <slot />
  </a>
</li>
