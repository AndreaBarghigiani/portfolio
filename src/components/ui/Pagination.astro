---
/**
 * Year-range pagination (docs/design-system.md section 8). Shows the current
 * range ("Page 1 · 2026 — 2024") with Newer and Older links labelled by the
 * range they lead to. Renders nothing for a single page.
 */
import ArrowLink from './ArrowLink.astro';
import type { PostArchivePage } from '@/lib/archive';

interface Props {
  pages: PostArchivePage[];
  current: number;
}

const { pages, current } = Astro.props;
const page = pages[current - 1];
const newer = pages[current - 2];
const older = pages[current];
---

{pages.length > 1 && page && <nav
  aria-label="Pagination"
  class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between"
>
  <p class="font-mono text-label tracking-label text-ink-subtle uppercase">
    Page {page.number} · {page.range}
  </p>
  <div class="flex flex-col lg:flex-row lg:gap-8">
    {newer && <ArrowLink href={newer.href} direction="back"> Newer · {newer.range} </ArrowLink>}
    {older && <ArrowLink href={older.href}>Older · {older.range}</ArrowLink>}
  </div>
</nav>}
