---
import { SquareArrowOutUpRightIcon } from '@lucide/astro';
import { render, type CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'jobs'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<li class="py-0.5">
  <details class="group">
    <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <div class="flex gap-5">
        <div class="relative min-w-28 shrink-0">
          <span class="text-sm text-muted-foreground">{entry.data.from} - {entry.data.to}</span>
        </div>

        <div class="flex flex-col gap-3 rounded-2xl p-2 transition-colors hover:bg-foreground/5">
          <div class="flex flex-col gap-1">
            <h4 class="font-medium text-headings">{entry.data.title}</h4>

            <p class="flex items-center gap-2 text-sm text-foreground">
              {entry.data.company}

              {entry.data.url ? (
                <a
                  href={entry.data.url}
                  title={`${entry.data.company} website`}
                  aria-label={`${entry.data.company} website`}
                  target="_blank"
                >
                  <SquareArrowOutUpRightIcon class="size-3" />
                </a>
              ) : null}
            </p>

            {entry.data.companyIntro ? (
              <span class="text-coffee-350 text-xs italic">{entry.data.companyIntro}</span>
            ) : null}
          </div>
        </div>
      </div>
    </summary>

    <div class="flex gap-5 pt-3">
      <div class="relative min-w-28 shrink-0"></div>

      <div class="flex flex-col gap-3">
        <div class="prose prose-sm prose-coffee dark:prose-invert">
          <Content />
        </div>
      </div>
    </div>
  </details>
</li>
