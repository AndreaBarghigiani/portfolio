---
import Head from '@/components/partials/Head.astro';
import Header from '@/components/partials/Header.astro';
import Footer from '@/components/partials/Footer.astro';
import Sheet from '@/components/layout/Sheet.astro';
import '@fontsource-variable/figtree';
import '@/styles/global.css';
import type { Seo } from '@/lib/constants';

interface Props {
  seo?: Seo;
}

const { seo } = Astro.props;
---

<html lang="en" class="bg-margin text-ink">
  <Head {seo} />

  <body id="top" class="relative flex min-h-dvh flex-col bg-margin text-ink">
    <Header />

    <Sheet>
      <slot />
    </Sheet>

    <Footer />
  </body>
</html>
