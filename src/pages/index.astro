---
import Row from '@/components/layout/Row.astro';
import Annotation from '@/components/ui/Annotation.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Button from '@/components/ui/Button.astro';
import EntryRow from '@/components/ui/EntryRow.astro';
import Figure from '@/components/ui/Figure.astro';
import JobRow from '@/components/ui/JobRow.astro';
import TopicTags from '@/components/ui/TopicTags.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import { ARROWS } from '@/lib/links';
import { getPublishedProjects } from '@/lib/projects';
import { formatDate, getPostSlugFromId, sortJobsByDate, sortPostsByDate } from '@/lib/utils';
import { getCollection, getEntry, render } from 'astro:content';

const home = await getEntry('pages', 'homepage');

if (!home) {
  throw new Error('Homepage not found');
}

const { Content } = await render(home);
const allLinks = await getCollection('links');
// The design shows three profile links; Bluesky stays in the collection but is not listed here.
const links = ['GitHub', 'LinkedIn', 'Twitter/X']
  .map((label) => allLinks.find((link) => link.data.label === label))
  .filter((link): link is NonNullable<typeof link> => Boolean(link));
const jobs = sortJobsByDate(await getCollection('jobs'));
const projects = await getPublishedProjects();
const featured = projects.find((project) => project.data.featured);
const compact = projects.filter((project) => project !== featured);
const [newest, ...nextPosts] = sortPostsByDate(await getCollection('posts')).slice(0, 3);

const { author } = DEFAULT_CONFIGURATION;
const postHref = (post: NonNullable<typeof newest>) => `/posts/${getPostSlugFromId(post.id)}/`;
// Contact actions come from the links collection (the email link is intentionally not in it).
const contactLinks = allLinks.filter((link) =>
  ['LinkedIn', 'Bluesky', 'Twitter/X'].includes(link.data.label)
);
---

<BaseLayout seo={home.data.seo}>
  <!-- Hero: text first in the DOM; the portrait follows on mobile and sits in the margin cell on desktop. -->
  <Row marginAfter>
    <div slot="margin" class="flex flex-col gap-4 tracking-[normal] normal-case">
      <Figure
        src={author.avatar}
        alt={`Portrait of ${author.name}`}
        priority
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 324px, 240px"
        class="max-w-60 lg:max-w-none"
      />
      <div aria-hidden="true"><Annotation>↑ that’s me, mid-refill</Annotation></div>
    </div>
    <h1 class="@container">
      <span
        class="block text-5xl font-light text-ink lg:text-[clamp(56px,10.96cqi,96px)] lg:tracking-display"
        >A little curiosity.</span
      >
      <span
        class="block text-5xl font-black text-accent lg:text-[clamp(90px,17.83cqi,156px)] lg:leading-none lg:tracking-display"
      >
        A lot of craft.
      </span>
    </h1>
    <p class="mt-8 max-w-copy text-lg text-ink-muted lg:text-xl">{home.data.seo.description}</p>
    <div class="mt-8 flex flex-col gap-4 lg:flex-row">
      <Button href="#projects">Selected projects</Button>
      <Button variant="outline" href="/posts/">Read the writing</Button>
    </div>
  </Row>

  {links.length > 0 && <Row flush>
    <h2 slot="margin" class="text-label font-normal">You can find me</h2>
    <ul class="flex flex-col lg:grid lg:auto-cols-fr lg:grid-flow-col">
      {links.map((link) => <li
        class="flex flex-col gap-1 border-b border-rule last:border-b-0 lg:border-r lg:border-b-0 lg:last:border-r-0"
      >
        <ArrowLink
          href={link.data.url}
          class="w-full justify-center py-6 hover:bg-raised focus:bg-raised lg:py-11"
        >
          {link.data.label}
          <span class="sr-only">{link.data.name} on {link.data.label}</span>
        </ArrowLink>
      </li>)}
    </ul>
  </Row>}

  <!-- "Method" principles are omitted until the owner supplies the copy (#50). -->

  {projects.length > 0 && <Row title="Ideas, put to work." display id="projects" flush>
    {featured && <div
      class="flex flex-col gap-4 border-b border-rule px-6 pt-8 pb-10 lg:px-12 lg:pt-12"
    >
      <h3 class="text-3xl font-black tracking-tight text-ink lg:text-4xl">
        {featured.data.title}
      </h3>
      <p class="max-w-copy text-base text-ink-muted">{featured.data.summary}</p>
      <div class="flex flex-col gap-4 lg:flex-row">
        <Button href={`/projects/${featured.id}/`}>View project</Button>
        {featured.data.website && <Button variant="outline" href={featured.data.website}>
          Website
        </Button>}
      </div>
    </div>}
    {compact.length > 0 && <ul>
      {compact.map((project, index) => (
        <EntryRow
          href={`/projects/${project.id}/`}
          title={project.data.title}
          meta={String(index + 1).padStart(2, '0')}
          description={project.data.summary}
        />
      ))}
    </ul>}
  </Row>}

  {newest && <Row tone="paper" title="Thinking out loud." display id="writing">
    <div slot="margin" class="font-sans text-base tracking-[normal] normal-case">
      <a
        href="/posts/"
        class="inline-flex min-h-12 items-center gap-2 font-semibold text-paper-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper-ink"
      >
        All writing <span aria-hidden="true">{ARROWS.internal}</span>
      </a>
    </div>
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-x-12">
      <a
        href={postHref(newest)}
        class="group block border-b border-paper-rule pb-8 outline-offset-4 focus-visible:outline-2 focus-visible:outline-paper-ink lg:border-b-0 lg:pb-0"
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="font-mono text-xs text-paper-ink-subtle"
            >{formatDate(newest.data.date)}</span
          >
          <TopicTags topics={newest.data.tags} tone="kraft" inLink />
        </div>
        <span
          class="mt-4 block text-3xl font-black tracking-tight wrap-break-word text-paper-ink group-hover:underline lg:text-4xl"
        >
          {newest.data.title}
        </span>
        <span class="mt-4 block max-w-copy text-base text-paper-ink-muted">
          {newest.data.seo.description}
        </span>
      </a>
      <ul>
        {nextPosts.map((post) => <li
          class="border-b border-paper-rule py-6 first:pt-0 last:border-b-0"
        >
          <a
            href={postHref(post)}
            class="group block min-h-12 outline-offset-4 focus-visible:outline-2 focus-visible:outline-paper-ink"
          >
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <span class="font-mono text-xs text-paper-ink-subtle">
                {formatDate(post.data.date)}
              </span>
              <TopicTags topics={post.data.tags} tone="kraft" inLink />
            </div>
            <span
              class="mt-2 block text-xl font-semibold wrap-break-word text-paper-ink group-hover:underline"
            >
              {post.data.title}
            </span>
            <span class="mt-2 block max-w-copy text-base text-paper-ink-muted">
              {post.data.seo.description}
            </span>
          </a>
        </li>)}
      </ul>
    </div>
  </Row>}

  <Row tone="raised">
    <h2 class="text-4xl font-black tracking-tight text-ink">About</h2>
    <div class="prose mt-8 prose-sheet">
      <Content />
    </div>
  </Row>

  {jobs.length > 0 && <Row title="What I've done over the years" id="experience">
    <ul>
      {jobs.map((job) => (
        <JobRow entry={job} />
      ))}
    </ul>
  </Row>}

  <Row tone="accent">
    <h2 class="max-w-copy text-4xl font-black tracking-tight text-on-accent lg:text-5xl">
      Let's connect and push the boundaries of what's possible
    </h2>
    {contactLinks.length > 0 && <ul class="mt-8 flex flex-col gap-4 lg:flex-row">
      {contactLinks.map((link) => <li>
        <a
          href={link.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-14 w-full items-center justify-center gap-2 border-2 border-on-accent px-8 text-sm font-semibold text-on-accent hover:bg-on-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-on-accent lg:w-auto"
        >
          {link.data.label === 'Twitter/X' ? `${link.data.name} on X` : link.data.label}
          <span aria-hidden="true">{ARROWS.external}</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>)}
    </ul>}
  </Row>
</BaseLayout>
