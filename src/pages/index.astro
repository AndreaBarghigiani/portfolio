---
import Container from '@/components/Container.astro';
import CoffeeHeading from '@/components/partials/CoffeeHeading.astro';
import Drops from '@/components/partials/Drops.astro';
import WorkExperience from '@/components/ui/WorkExperience.astro';
import ProjectPreview from '@/components/ui/ProjectPreview.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedProjects } from '@/lib/projects';
import { sortJobsByDate } from '@/lib/utils';
import { getCollection, getEntry, render } from 'astro:content';

const home = await getEntry('pages', 'homepage');

if (!home) {
  throw new Error('Homepage not found');
}

const { Content } = await render(home);

const links = await getCollection('links');

const jobs = await getCollection('jobs');
const sortedJobs = sortJobsByDate(jobs);
const featuredProjects = (await getPublishedProjects()).filter((project) => project.data.featured);
---

<BaseLayout>
  <Drops />

  <Container as="section" class="flex flex-col gap-5">
    <CoffeeHeading icon="drop-5">About</CoffeeHeading>

    <div class="prose prose-coffee dark:prose-invert">
      <Content />
    </div>
  </Container>

  {links.length > 0 && <Container as="section" class="py-8">
    <div class="flex flex-col gap-5">
      <CoffeeHeading icon="drop-3">Where you can find me</CoffeeHeading>

      <ul class="flex flex-col gap-3">
        {links.map((link) => <li class="flex items-center gap-5 py-0.5 text-sm">
          <span class="min-w-28 text-muted-foreground">{link.data.label}</span>
          <a
            class="font-medium text-headings"
            rel="noopener noreferrer"
            target="_blank"
            href={link.data.url}
          >
            {link.data.name}
          </a>
        </li>)}
      </ul>
    </div>
  </Container>}

  {featuredProjects.length > 0 && <Container
    as="section"
    class="flex scroll-mt-32 flex-col gap-5 py-8"
    id="projects"
  >
    <CoffeeHeading icon="drop-4">Selected projects</CoffeeHeading>
    <ul>
      {featuredProjects.map((entry) => (
        <ProjectPreview {entry} />
      ))}
    </ul>
  </Container>}

  {sortedJobs.length > 0 ? (
    <Container as="section" class="flex flex-col gap-5 py-6">
      <CoffeeHeading icon="stain" iconClass="size-5"> What I've done over the years </CoffeeHeading>

      <ul class="flex flex-col gap-8">
        {sortedJobs.map((job) => (
          <WorkExperience entry={job} />
        ))}
      </ul>
    </Container>
  ) : null}
</BaseLayout>
