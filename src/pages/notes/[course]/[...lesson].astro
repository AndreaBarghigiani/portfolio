---
import Row from '@/components/layout/Row.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import type { Seo } from '@/lib/constants';
import { getLessonRouteInfoFromId, getNotesSlugFromId } from '@/lib/utils';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DetailHead from '@/components/partials/DetailHead.astro';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import Facts from '@/components/ui/Facts.astro';
import KeepReading from '@/components/ui/KeepReading.astro';
import ReadingBar from '@/components/ui/ReadingBar.astro';
import Toc from '@/components/ui/Toc.astro';
import { getCourseModules, lessonHref } from '@/lib/notes';

export async function getStaticPaths() {
  const lessons = await getCollection('lessonNotes');
  const courses = await getCollection('notes');
  const modules = await getCollection('courseModules');

  return lessons.map((lesson: CollectionEntry<'lessonNotes'>) => {
    const { courseSlug, lessonPath } = getLessonRouteInfoFromId(lesson.id);
    const courseEntry =
      courses.find((course) => getNotesSlugFromId(course.id) === courseSlug) ?? null;
    const moduleId =
      typeof lesson.data.module === 'string'
        ? lesson.data.module
        : (lesson.data.module?.id ?? null);
    const moduleEntry = moduleId
      ? (modules.find((module) => module.id === moduleId) ?? null)
      : null;

    return {
      params: {
        course: courseSlug,
        lesson: lessonPath,
      },
      props: {
        lesson,
        courseEntry,
        moduleEntry,
      },
    };
  });
}

const { lesson, courseEntry, moduleEntry } = Astro.props;
const { Content } = await render(lesson);

const lessonSeo: Seo = {
  title: courseEntry
    ? `${lesson.data.title} | ${courseEntry.data.title}`
    : `${lesson.data.title} | Course Notes`,
  description:
    lesson.data.description ??
    (courseEntry ? courseEntry.data.description : DEFAULT_CONFIGURATION.seo.description),
};

const courseSlug = courseEntry
  ? getNotesSlugFromId(courseEntry.id)
  : getLessonRouteInfoFromId(lesson.id).courseSlug;
const modules = await getCourseModules(courseSlug);
const flat = modules.flatMap((group) => group.lessons);
const position = flat.findIndex((item) => item.id === lesson.id);
const currentModule = modules.find((group) => group.lessons.some((item) => item.id === lesson.id));
const neighbours = [flat[position - 1], flat[position + 1]].filter(
  (item): item is NonNullable<typeof item> => Boolean(item)
);

const lessonItems = (currentModule?.lessons ?? []).map((item) => ({
  href: lessonHref(courseSlug, item),
  text: item.data.title,
  current: item.id === lesson.id,
}));
const courseHref = `/notes/${courseSlug}/`;
---

<BaseLayout seo={lessonSeo}>
  <article data-detail class="flex flex-1 flex-col">
    <DetailHead
      title={lesson.data.title}
      standfirst={lesson.data.description}
      back={{
        label: courseEntry?.data.title ?? 'Notes',
        href: courseEntry ? courseHref : '/notes/',
      }}
    >
      <Facts
        slot="facts"
        items={[
          { label: 'Module', value: moduleEntry?.data.title },
          {
            label: 'Course',
            value: courseEntry?.data.title,
            href: courseEntry ? courseHref : undefined,
          },
        ]}
      />
    </DetailHead>

    <Row measure="copy">
      <Toc slot="margin" items={lessonItems} label="In this module" />
      <div class="prose prose-sheet">
        <Content components={{ pre: CodeBlock }} />
      </div>
    </Row>

    <ReadingBar label={lesson.data.title} />
  </article>

  <KeepReading
    title="Next up"
    items={neighbours.map((item) => ({
      href: lessonHref(courseSlug, item),
      title: item.data.title,
      meta: item === flat[position - 1] ? 'Previous' : 'Next',
    }))}
  />
</BaseLayout>
