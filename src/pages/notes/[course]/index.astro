---
import Row from '@/components/layout/Row.astro';
import DetailHead from '@/components/partials/DetailHead.astro';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import EntryRow from '@/components/ui/EntryRow.astro';
import Facts from '@/components/ui/Facts.astro';
import KeepReading from '@/components/ui/KeepReading.astro';
import ReadingBar from '@/components/ui/ReadingBar.astro';
import ShowMore from '@/components/ui/ShowMore.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Seo } from '@/lib/constants';
import { getCourseModules, lessonHref } from '@/lib/notes';
import { getNotesSlugFromId } from '@/lib/utils';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const courses = await getCollection('notes');

  return courses.map((course) => {
    const slug = getNotesSlugFromId(course.id);

    return {
      params: { course: slug },
      props: { entry: course },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const entrySlug = getNotesSlugFromId(entry.id);

const courseSeo: Seo = {
  title: `${entry.data.title} | Course Notes`,
  description: entry.data.description,
  type: 'website',
};

const VISIBLE = 3;
const groupedLessons = await getCourseModules(entrySlug);
const otherCourses = (await getCollection('notes')).filter((course) => course.id !== entry.id);
---

<BaseLayout seo={courseSeo}>
  <article data-detail class="flex flex-1 flex-col">
    <DetailHead
      title={entry.data.title}
      standfirst={entry.data.description}
      back={{ label: 'Notes', href: '/notes/' }}
    >
      <Facts
        slot="facts"
        items={[
          { label: 'Instructor', value: entry.data.author },
          { label: 'Course site', value: 'Course website', href: entry.data.url },
          {
            label: 'Certificate',
            value: entry.data.certificateUrl ? 'View completion certificate' : undefined,
            href: entry.data.certificateUrl,
          },
        ]}
      />
    </DetailHead>

    <Row tone="raised" measure="copy">
      <div class="prose prose-sheet">
        <Content components={{ pre: CodeBlock }} />
      </div>
    </Row>

    {groupedLessons.length === 0 ? (
      <Row>
        <p class="text-sm text-ink-muted">No lessons published for this course yet.</p>
      </Row>
    ) : (
      groupedLessons.map((group) => {
        const remaining = Math.max(group.lessons.length - VISIBLE, 0);
        return <Row title={group.moduleName} id={`module-${group.moduleKey}`} flush>
          {group.moduleDescription && <p
            class:list={[group.moduleUrl && 'mb-4', 'px-6 text-sm text-ink-muted lg:px-12']}
          >
            {group.moduleDescription}
          </p>}
          {group.moduleUrl && <p class="px-6 text-sm lg:px-12">
            <ArrowLink href={group.moduleUrl}>Visit module page</ArrowLink>
          </p>}
          <ul class:list={[group.moduleDescription || group.moduleUrl ? 'pt-4' : '']}>
            {group.lessons.map((lesson, index) => (
              <EntryRow
                href={lessonHref(entrySlug, lesson)}
                title={lesson.data.title}
                meta={String(index + 1).padStart(2, '0')}
                description={lesson.data.description}
                more={index >= VISIBLE}
                group={`module-${group.moduleKey}`}
              />
            ))}
          </ul>
          {remaining > 0 && <div class="px-6 lg:px-12">
            <ShowMore group={`module-${group.moduleKey}`} count={remaining} noun="lessons" />
          </div>}
        </Row>;
      })
    )}

    <ReadingBar label={entry.data.title} />
  </article>

  <KeepReading
    title="More notes"
    items={otherCourses.map((course) => ({
      href: `/notes/${course.id}/`,
      title: course.data.title,
    }))}
  />
</BaseLayout>
