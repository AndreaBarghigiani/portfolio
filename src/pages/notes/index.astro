---
import Row from '@/components/layout/Row.astro';
import ArchiveHead from '@/components/partials/ArchiveHead.astro';
import CollectionRow from '@/components/ui/CollectionRow.astro';
import ShowMore from '@/components/ui/ShowMore.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const entry = await getEntry('pages', 'notes');

if (!entry) {
  throw new Error('Notes page not found');
}

const courses = await getCollection('notes');
const VISIBLE = 3;
const remaining = Math.max(courses.length - VISIBLE, 0);
---

<BaseLayout seo={entry.data.seo} framed>
  <ArchiveHead title={entry.data.title} current="notes">
    Explore detailed notes captured while studying courses, workshops, and live trainings.
  </ArchiveHead>

  {courses.length === 0 ? (
    <Row>
      <p>No notes published yet.</p>
    </Row>
  ) : (
    <>
      <ul>
        {courses.map((course, index) => (
          <CollectionRow
            href={`/notes/${course.id}/`}
            title={course.data.title}
            summary={course.data.description}
            index={`N-${String(index + 1).padStart(2, '0')}`}
            more={index >= VISIBLE}
            group="notes"
          />
        ))}
      </ul>
      {remaining > 0 && <Row>
        <ShowMore group="notes" count={remaining} noun="notes" singularNoun="note" />
      </Row>}
    </>
  )}
</BaseLayout>
