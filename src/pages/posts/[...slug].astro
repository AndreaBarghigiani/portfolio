---
import Row from '@/components/layout/Row.astro';
import DetailHead from '@/components/partials/DetailHead.astro';
import Author from '@/components/ui/Author.astro';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import Facts from '@/components/ui/Facts.astro';
import KeepReading from '@/components/ui/KeepReading.astro';
import ReadingBar from '@/components/ui/ReadingBar.astro';
import Toc from '@/components/ui/Toc.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import { formatDate, getPostSlugFromId, sortPostsByDate } from '@/lib/utils';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  const series = await getCollection('series');

  return entries.map((entry) => {
    const postSlug = getPostSlugFromId(entry.id);

    return {
      params: { slug: postSlug },
      props: {
        entry,
        seriesData: entry.data.series?.ref
          ? series.find((s) => s.id === entry.data.series!.ref!.id)
          : null,
      },
    };
  });
}

const { entry, seriesData } = Astro.props;
const { Content, headings } = await render(entry);

const posts = await getCollection('posts');
const seriesPosts = seriesData
  ? posts
      .filter((post) => post.data.series?.ref.id === seriesData.id)
      .sort((a, b) => (a.data.series?.number ?? 0) - (b.data.series?.number ?? 0))
  : [];
const ordered = seriesData ? seriesPosts : sortPostsByDate(posts);
const position = ordered.findIndex((post) => post.id === entry.id);
// Series follow reading order (previous, next); otherwise newer then older.
const neighbours = (
  seriesData
    ? [ordered[position - 1], ordered[position + 1]]
    : [ordered[position - 1], ordered[position + 1]]
).filter((post): post is NonNullable<typeof post> => Boolean(post));

const tocItems = headings.map((heading) => ({
  href: `#${heading.slug}`,
  text: heading.text,
  depth: heading.depth,
}));
---

<BaseLayout seo={entry.data.seo}>
  <article data-detail class="flex flex-1 flex-col">
    <DetailHead
      title={entry.data.title}
      standfirst={entry.data.seo.description}
      back={{ label: 'Posts', href: '/posts/' }}
    >
      <Facts
        slot="facts"
        items={[
          { label: 'Published', value: formatDate(entry.data.date) },
          {
            label: 'Series',
            value: seriesData?.data.title,
            href: seriesData ? `/series/${seriesData.id}/` : undefined,
          },
          {
            label: 'Part',
            value: entry.data.series
              ? `${entry.data.series.number} of ${seriesPosts.length}`
              : undefined,
          },
        ]}
      />
    </DetailHead>

    <Row measure="copy">
      <Toc slot="margin" items={tocItems} />
      <div class="prose prose-sheet">
        <Content components={{ pre: CodeBlock }} />
      </div>
      <div class="mt-16 border-t border-rule pt-8">
        <Author {...DEFAULT_CONFIGURATION.author} />
      </div>
    </Row>

    <ReadingBar label={entry.data.title} />
  </article>

  <KeepReading
    items={neighbours.map((post) => ({
      href: `/posts/${getPostSlugFromId(post.id)}/`,
      title: post.data.title,
      meta: formatDate(post.data.date),
    }))}
  />
</BaseLayout>
