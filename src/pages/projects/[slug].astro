---
import { Image } from 'astro:assets';
import Row from '@/components/layout/Row.astro';
import DetailHead from '@/components/partials/DetailHead.astro';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import Facts from '@/components/ui/Facts.astro';
import Figure from '@/components/ui/Figure.astro';
import KeepReading from '@/components/ui/KeepReading.astro';
import ReadingBar from '@/components/ui/ReadingBar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedProjects } from '@/lib/projects';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seo = {
  title: entry.data.title,
  description: entry.data.summary,
  canonicalUrl: `https://cupofcraft.dev/projects/${entry.id}/`,
};
const otherProjects = (await getPublishedProjects()).filter((project) => project.id !== entry.id);
const images = entry.data.media?.filter((item) => item.type === 'image') ?? [];
const videos = entry.data.media?.filter((item) => item.type !== 'image') ?? [];
---

<BaseLayout {seo}>
  <article data-detail class="flex flex-1 flex-col">
    <DetailHead
      title={entry.data.title}
      standfirst={entry.data.summary}
      back={{ label: 'Projects', href: '/projects/' }}
    >
      <Facts
        slot="facts"
        items={[
          {
            label: 'Website',
            value: entry.data.website ? 'Visit website' : undefined,
            href: entry.data.website,
          },
          {
            label: 'Source',
            value: entry.data.github ? 'Source code' : undefined,
            href: entry.data.github,
          },
        ]}
      />
    </DetailHead>

    {(entry.data.logo || entry.data.cover || entry.data.media?.length) && <Row>
      <div class="flex max-w-copy flex-col gap-8">
        {entry.data.logo && (
          <Image
            src={entry.data.logo.src}
            alt={entry.data.logo.alt}
            class="size-16 object-contain"
          />
        )}
        {entry.data.cover && (
          <Figure
            src={entry.data.cover.src}
            alt={entry.data.cover.alt}
            caption={entry.data.cover.caption}
          />
        )}
        {images.map((item) => (
          <Figure src={item.src} alt={item.alt} caption={item.caption} />
        ))}
        {videos.map((item) => <section class="flex flex-col gap-3" aria-label={item.title}>
          <video
            class="h-auto w-full border border-rule"
            width={item.width}
            height={item.height}
            controls
            preload="metadata"
            aria-label={item.title}
          >
            <source src={item.src} />
            {item.captions && (
              <track
                kind="captions"
                src={item.captions.src}
                srclang={item.captions.srclang}
                label={item.captions.label}
                default
              />
            )}
            Your browser does not support embedded video. Read the transcript below.
          </video>
          <details class="border-b border-rule py-3">
            <summary class="flex min-h-12 cursor-pointer items-center font-medium text-ink">
              Video transcript
            </summary>
            <p class="max-w-prose leading-relaxed text-ink-muted">{item.transcript}</p>
          </details>
        </section>)}
      </div>
    </Row>}

    <Row measure="copy">
      <div class="prose prose-sheet">
        <Content components={{ pre: CodeBlock }} />
      </div>
    </Row>

    <ReadingBar label={entry.data.title} />
  </article>

  <KeepReading
    title="More projects"
    items={otherProjects.map((project) => ({
      href: `/projects/${project.id}/`,
      title: project.data.title,
    }))}
  />
</BaseLayout>
