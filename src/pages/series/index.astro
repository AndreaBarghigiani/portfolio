---
import Row from '@/components/layout/Row.astro';
import ArchiveHead from '@/components/partials/ArchiveHead.astro';
import EntryRow from '@/components/ui/EntryRow.astro';
import ShowMore from '@/components/ui/ShowMore.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const series = await getCollection('series');
const VISIBLE = 3;
const remaining = Math.max(series.length - VISIBLE, 0);
---

<BaseLayout>
  <ArchiveHead title="Series" current="series">
    When an article is not enough, or I am documenting my journey with something specific, I like to
    create a series about it!
  </ArchiveHead>

  {series.length === 0 ? (
    <Row>
      <p>No posts found</p>
    </Row>
  ) : (
    <Row flush>
      <ul>
        {series.map((single, index) => (
          <EntryRow
            href={`/series/${single.id}/`}
            title={single.data.title}
            meta={String(index + 1).padStart(2, '0')}
            description={single.data.seo.description}
            more={index >= VISIBLE}
            group="series"
          />
        ))}
      </ul>
      {remaining > 0 && <div class="px-6 lg:px-12">
        <ShowMore group="series" count={remaining} noun="series" singularNoun="series" />
      </div>}
    </Row>
  )}
</BaseLayout>
