---
import Row from '@/components/layout/Row.astro';
import ArchiveHead from '@/components/partials/ArchiveHead.astro';
import CollectionRow from '@/components/ui/CollectionRow.astro';
import ShowMore from '@/components/ui/ShowMore.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const series = await getCollection('series');
const posts = await getCollection('posts');
const entryCount = (id: string) => posts.filter((post) => post.data.series?.ref.id === id).length;
const VISIBLE = 3;
const remaining = Math.max(series.length - VISIBLE, 0);
---

<BaseLayout framed>
  <ArchiveHead title="Series" current="series">
    When an article is not enough, or I am documenting my journey with something specific, I like to
    create a series about it!
  </ArchiveHead>

  {series.length === 0 ? (
    <Row>
      <p>No posts found</p>
    </Row>
  ) : (
    <>
      <ul>
        {series.map((single, index) => (
          <CollectionRow
            href={`/series/${single.id}/`}
            title={single.data.title}
            summary={single.data.seo.description}
            index={`S-${String(index + 1).padStart(2, '0')}`}
            detail={`${entryCount(single.id)} ${entryCount(single.id) === 1 ? 'entry' : 'entries'}`}
            more={index >= VISIBLE}
            group="series"
          />
        ))}
      </ul>
      {remaining > 0 && <Row>
        <ShowMore group="series" count={remaining} noun="series" singularNoun="series" />
      </Row>}
    </>
  )}
</BaseLayout>
