{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupofcraft-portfolio",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/dev/*"],
  },
}
